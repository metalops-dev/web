---
import { siteConfig } from "../config/site";
---

<aside class="newsletter">
	<h3>Newsletter</h3>
	<p>Get notified when I publish new posts. No spam.</p>
	<a href={siteConfig.substack.url} target="_blank" rel="noopener noreferrer" class="subscribe-btn">
		Subscribe on Substack →
	</a>
</aside>

<style>
	.newsletter {
		margin: 3rem 0;
		padding: 1.75rem;
		border: 1px solid var(--border);
		background: var(--surface);
		box-shadow: var(--shadow);
		border-radius: var(--radius, 6px);
		position: relative;
		overflow: hidden;
	}
	.newsletter::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), var(--accent-light));
	}
	.newsletter:hover::before {
		background: linear-gradient(90deg, var(--accent-light), var(--accent));
	}

	.newsletter h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--fg);
	}
	.newsletter p {
		margin: 0 0 1.25rem 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.subscribe-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.6rem 1.25rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.85rem;
		border-radius: var(--radius, 6px);
		border: none;
		border-bottom: none;
		position: relative;
		overflow: hidden;
		transition: background 0.2s, transform 0.15s;
	}
	.subscribe-btn::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			105deg,
			transparent 40%,
			rgba(255, 255, 255, 0.3) 50%,
			transparent 60%
		);
		pointer-events: none;
		opacity: 0;
	}
	.subscribe-btn:hover {
		background: var(--accent-light);
		color: white;
		transform: translateY(-1px);
		border-bottom: none;
	}
	.subscribe-btn:hover::after {
		animation: sheen 0.7s ease-in-out forwards;
	}

	@keyframes sheen {
		0% {
			transform: translateX(-100%);
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		100% {
			transform: translateX(100%);
			opacity: 0;
		}
	}
</style>
