---
import FormattedDate from "./FormattedDate.astro";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	description?: string;
	tags?: string[];
	draft?: boolean;
}

const {
	title,
	slug,
	pubDate,
	description,
	tags = [],
	draft = false,
} = Astro.props;
---

	<li class:list={["post-card", { draft }]}>
	<a href={`/blog/${slug}/`}>
		<span class="post-card-title">
			{draft && <span class="draft-indicator" title="Draft">◇</span>}
			{title}
		</span>
		<span class="post-card-meta">
			<span class="post-card-date">
				<FormattedDate date={pubDate} />
			</span>
			{description && <span class="post-card-description">{description}</span>}
		</span>
		{tags && tags.length > 0 && (
			<span class="post-card-tags">
				{tags.slice(0, 3).map((tag) => (
					<span class="post-card-tag">{tag}</span>
				))}
			</span>
		)}
		<span class="read-arrow" aria-hidden="true">→</span>
	</a>
</li>

<style>
	.post-card {
		margin: 0;
		list-style: none;
	}

	.post-card a {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.875rem 0.75rem;
		text-decoration: none;
		color: var(--fg);
		border-bottom: none;
		border-radius: var(--radius);
		transition:
			background 0.15s,
			transform 0.15s;
		margin: 0 -0.75rem;
		position: relative;
		overflow: hidden;
	}

	.post-card a::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--accent);
		transform: translateX(-70%);
		transition: transform 0.2s ease;
		opacity: 0.3;
		border-radius: 0 2px 2px 0;
	}

	.post-card a:hover {
		background: var(--surface);
		transform: translateX(4px);
		color: var(--fg);
	}

	.post-card a:hover::before {
		transform: translateX(0);
		opacity: 1;
	}

	.post-card.draft {
		opacity: 0.7;
	}

	.post-card-title {
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.draft-indicator {
		color: #f59e0b;
		font-size: 0.9em;
	}

	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.post-card-date {
		font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
		font-size: 0.75rem;
		flex-shrink: 0;
	}

	.post-card-description {
		color: var(--muted);
		font-size: 0.85rem;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card a:hover .date {
		color: var(--muted);
	}

	.post-card-tags {
		display: flex;
		gap: 0.375rem;
		flex-wrap: wrap;
	}

	.post-card-tag {
		font-size: 0.65rem;
		padding: 0.15rem 0.45rem;
		border-radius: 3px;
		background: var(--accent-muted);
		color: var(--accent);
		font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.read-arrow {
		position: absolute;
		right: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--accent);
		font-size: 1rem;
		opacity: 0;
		transition: opacity 0.15s, transform 0.15s;
	}

	.post-card a:hover .read-arrow {
		opacity: 1;
		transform: translateY(-50%) translateX(4px);
	}
</style>
