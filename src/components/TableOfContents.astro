---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only h2 and h3 for cleaner TOC
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
	<>
	<button class="toc-toggle" aria-label="Toggle table of contents" aria-expanded="false">† toc</button>
	<nav class="toc" aria-label="Table of contents">
		{filteredHeadings.map((heading) => (
			<a
				href={`#${heading.slug}`}
				data-slug={heading.slug}
				class={`toc-link depth-${heading.depth}`}
			>{heading.text}</a>
		))}
	</nav>
	</>
)}

<script>
	function initTOC() {
		const tocLinks = document.querySelectorAll('.toc-link');

		if (tocLinks.length === 0) return;

		const headings = Array.from(tocLinks).map(link => {
			const slug = link.getAttribute('data-slug');
			return document.getElementById(slug || '');
		}).filter(Boolean) as HTMLElement[];

		if (headings.length === 0) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach(entry => {
					const id = entry.target.id;
					const link = document.querySelector(`.toc-link[data-slug="${id}"]`);
					if (entry.isIntersecting) {
						tocLinks.forEach(l => l.classList.remove('is-active'));
						link?.classList.add('is-active');
					}
				});
			},
			{ rootMargin: '-80px 0px -70% 0px' }
		);

		headings.forEach(heading => observer.observe(heading));

		// Mobile TOC toggle
		const toggle = document.querySelector('.toc-toggle') as HTMLElement | null;
		const toc = document.querySelector('.toc') as HTMLElement | null;
		if (toggle && toc) {
			toggle.addEventListener('click', () => {
				const isOpen = toc.classList.toggle('toc-open');
				toggle.setAttribute('aria-expanded', String(isOpen));
				toggle.textContent = isOpen ? '† close' : '† toc';
			});
		}
	}

	initTOC();
	document.addEventListener('astro:after-swap', initTOC);
</script>

<style>
	.toc {
		position: fixed;
		left: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 6px;
		z-index: 100;
	}

	.toc-toggle {
		display: none;
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 100;
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.5rem 0.875rem;
		border-radius: var(--radius);
		font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
		font-size: 0.75rem;
		cursor: pointer;
		box-shadow: var(--shadow-lg);
		transition: transform 0.2s;
	}

	.toc-toggle:hover {
		transform: translateY(-2px);
	}

	.toc-link {
		display: block;
		text-decoration: none;
		color: var(--muted);
		opacity: 0.35;
		font-size: 0.75rem;
		line-height: 1.2;
		font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
		transition: opacity 0.2s, color 0.2s;
		max-width: 160px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.toc-link:hover {
		opacity: 0.7;
		color: var(--accent);
	}

	.toc-link.is-active {
		opacity: 1;
		color: var(--accent);
	}

	.toc-link.depth-3 {
		font-size: 0.7rem;
		margin-left: 0.5rem;
	}

	@media (max-width: 1100px) {
		.toc {
			display: none;
			position: fixed;
			bottom: 4.5rem;
			right: 1.5rem;
			top: auto;
			left: auto;
			transform: none;
			background: var(--bg);
			border: 1px solid var(--border);
			padding: 0.75rem;
			border-radius: var(--radius);
			box-shadow: var(--shadow-lg);
			z-index: 99;
			gap: 0.5rem;
			max-height: 50vh;
			overflow-y: auto;
		}

		.toc.toc-open {
			display: flex;
		}

		.toc-toggle {
			display: block;
		}
	}
</style>
