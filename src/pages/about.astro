---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About metalops.dev" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<article class="page-article">
				<header>
					<h1>About metalops<span class="dot">.</span>dev</h1>
					<p class="subtitle">
						Independent infrastructure engineering, from bare metal to distributed systems.
					</p>
				</header>

				<div class="content">
					<div class="manifesto">
						<p>
							<strong>MetalOps</strong> is Adrian Villanueva’s independent engineering practice and technical publication.
							Build, measure, break, understand: infrastructure should be understandable, measurable,
							recoverable, and under the operator’s control.
						</p>
					</div>

					<p>
						I care about operator control because the people responsible for a system should be able to
						understand how it works, investigate what goes wrong, and recover it when it fails.
						That means looking beyond whether a tool works to how it behaves under pressure and what it takes to run.
					</p>

					<h2>▸ realms of focus</h2>
					<ul class="topics">
						<li>Systems engineering</li>
						<li>Infrastructure engineering</li>
						<li>Distributed systems and data</li>
						<li>Reliability engineering</li>
						<li>AI infrastructure</li>
					</ul>

					<hr />

					<div class="callout">
						<p>
							Find me on <a href="https://adrianvillanueva.com" target="_blank" rel="noopener">adrianvillanueva.com</a>
						</p>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-article header {
		margin-bottom: 2.5rem;
	}

	h1 {
		margin: 0 0 0.5rem 0;
	}

	.dot {
		color: var(--accent);
	}

	.subtitle {
		color: var(--muted);
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 520px;
	}

	.content {
		line-height: 1.8;
		color: var(--fg);
	}

	.manifesto {
		padding: 1.25rem 1.5rem;
		margin-bottom: 2rem;
		border: 1px solid var(--accent-muted);
		background: var(--accent-muted);
		border-radius: var(--radius, 6px);
		position: relative;
	}

	.manifesto::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 0 var(--radius, 6px) var(--radius, 6px) 0;
		background: linear-gradient(180deg, var(--accent) 0%, transparent 100%);
		opacity: 0.04;
		pointer-events: none;
	}

	.manifesto p {
		margin: 0;
	}

	.manifesto strong {
		color: var(--fg);
	}

	h2 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0 0 1rem 0;
		border: none;
		padding: 0;
		font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
	}

	h2::before {
		display: none;
	}

	.topics {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem 0;
	}

	.topics li {
		margin-bottom: 0.75rem;
		padding-left: 1.5rem;
		position: relative;
		font-size: 1rem;
	}

	.topics li::before {
		content: "⛧";
		position: absolute;
		left: 0;
		color: var(--accent);
		font-size: 0.75rem;
		opacity: 0.6;
	}

	.callout {
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		background: var(--surface);
		border-radius: var(--radius, 6px);
		margin-top: 0.5rem;
	}

	.callout p {
		margin: 0;
		color: var(--muted);
	}

	.callout a {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid var(--accent-muted);
	}

	.callout a:hover {
		background: transparent;
		color: var(--accent-light);
		border-bottom-color: var(--accent);
	}
</style>
