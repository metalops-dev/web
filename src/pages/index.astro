---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostList from "../components/PostList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allPosts = await getCollection("blog");
const posts = (
	import.meta.env.PROD ? allPosts.filter((post) => !post.data.draft) : allPosts
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<section class="intro">
				<h1>metalops<span class="dot">.</span>dev</h1>
				<p class="tagline">
				A technical blog about software, systems engineering, infrastructure and DevOps. Deep dives on Rust, infrastructure automation, and building resilient production systems.
				</p>
			</section>

			<section class="posts">
				<div class="section-header">
					<h2>Recent Posts</h2>
					<a href="/blog" class="all-posts">view all &rarr;</a>
				</div>
				<PostList posts={posts} showDescription={true} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 4rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--accent);
		position: relative;
	}

	.intro::before {
		content: "†";
		position: absolute;
		right: 0;
		top: -0.5rem;
		font-size: 8rem;
		color: var(--accent);
		opacity: 0.04;
		line-height: 1;
		font-family: "Cinzel", "Georgia", "Times New Roman", serif;
		pointer-events: none;
		user-select: none;
	}

	.intro::after {
		content: "";
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, var(--accent), transparent 80%);
	}
	.intro h1 {
		font-size: 3rem;
		margin: 0 0 1rem 0;
		line-height: 1.1;
		letter-spacing: -0.04em;
	}
	.dot {
		color: var(--accent);
	}
	.tagline {
		color: var(--muted);
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.7;
		max-width: 520px;
	}
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
	}
	.posts h2 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0;
		border: none;
		padding-left: 0;
	}
	.posts h2::before {
		display: none;
	}
	.all-posts {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--accent);
		border-bottom: none;
		transition: gap 0.2s;
	}
	.all-posts:hover {
		color: var(--accent-light);
	}
	@media (max-width: 600px) {
		.intro h1 {
			font-size: 2.25rem;
		}
		.tagline {
			font-size: 1rem;
		}
	}
</style>
